{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Authentication": {
    "Google": {
      "ClientId": ""
    }
  },
  "Jwt": {
    "Key": "",
    "Issuer": "https://api.requirement-ai.com",
    "Audience": "https://www.requirement-ai.com",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Argon2": {
    "TimeCost": 4,
    "MemoryCost": 65536,
    "Lanes": 4,
    "SaltLength": 16
  },
  "Frontend": {
    "Url": "https://www.requirement-ai.com"
  },
  "LLM": {
    "Providers": {
      "openai-main": {
        "Type": "OpenAI",
        "ApiKey": "",
        "Models": {
          "gpt-5.5": "gpt-5.5",
          "gpt-4o": "gpt-4o"
        }
      },
      "anthropic-main": {
        "Type": "Anthropic",
        "ApiKey": "",
        "BaseUrl": "https://api.anthropic.com",
        "Models": {
          "claude-opus-4.8": "claude-opus-4-8"
        }
      },
      "moonshot-main": {
        "Type": "MoonshotAI",
        "ApiKey": "",
        "BaseUrl": "https://api.moonshot.ai/v1",
        "Models": {
          "kimi-k2.6": "kimi-k2.6"
        }
      },
      "google-main": {
        "Type": "Google",
        "ApiKey": "",
        "BaseUrl": "https://generativelanguage.googleapis.com/v1beta",
        "Models": {
          "gemini-2.5-pro": "gemini-2.5-pro"
        }
      }
    },
    "Routing": {
      "Refinement": {
        "Provider": "openai-main",
        "Model": "gpt-5.5"
      },
      "Analysis": {
        "Provider": "openai-main",
        "Model": "gpt-5.5"
      }
    }
  },
  "Refinement": {
    "AnalysisFreshnessHours": 24,
    "AnalysisPollingIntervalSeconds": 1,
    "AnalysisWaitTimeoutMinutes": 30
  },
  "AutoMapperOptions": {
    "LicenceKey": ""
  }
}
