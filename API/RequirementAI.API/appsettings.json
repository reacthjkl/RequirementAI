{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/api-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Authentication": {
    "RegistrationSecret": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "https://api.requirement-ai.com",
    "Audience": "https://www.requirement-ai.com",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "Argon2": {
    "TimeCost": 4,
    "MemoryCost": 65536,
    "Lanes": 4,
    "SaltLength": 16
  },
  "Frontend": {
    "Url": "https://www.requirement-ai.com"
  },
  "AutoMapperOptions": {
    "LicenseKey": ""
  }
}
