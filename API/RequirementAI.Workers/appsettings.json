{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/worker-log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "shared": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "LLM": {
    "Providers": {
      "openai-main": {
        "Type": "OpenAI",
        "ApiKey": "",
        "Models": {
          "quality": "gpt-5.5"
        }
      }
    },
    "Routing": {
      "Refinement": {
        "Provider": "openai-main",
        "Model": "quality"
      },
      "Analysis": {
        "Provider": "openai-main",
        "Model": "quality"
      }
    }
  },
  "Refinement": {
    "AnalysisFreshnessHours": 24,
    "AnalysisPollingIntervalSeconds": 1,
    "AnalysisWaitTimeoutMinutes": 30
  },
  "AutoMapperOptions": {
    "LicenceKey": ""
  }
}
